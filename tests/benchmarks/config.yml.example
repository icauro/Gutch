# Copy this file to config.yml and fill in the benchmark paths, credentials,
# and SSH target values. The copied config.yml is ignored by Git.

local:
  product_root: C:/datasets/products
  artifacts_root: .artifacts

environment:
  S3_MAIN_BUCKET_NAME: ""
  S3_MAIN_ENDPOINT: ""
  S3_MAIN_REGION: auto
  S3_MAIN_ACCESS_KEY: ""
  S3_MAIN_SECRET_KEY: ""
  S3_PUBLIC_BUCKET_NAME: ""
  S3_PUBLIC_ENDPOINT: ""
  S3_PUBLIC_REGION: auto
  S3_PUBLIC_ACCESS_KEY: ""
  S3_PUBLIC_SECRET_KEY: ""

remote:
  default_target: sv1
  workspace_root: /tmp/hostapp-gutch-benchmark
  fixtures_root: /home/user/hostapp/benchmark-fixtures/gutch
  python: python3

ssh:
  sv1:
    host: ""
    port: 22
    user: ""
    host_alias: ""
    identity_file: ""

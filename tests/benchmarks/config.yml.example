# Copy this file to config.yml and fill in the benchmark paths, credentials,
# and SSH target values. The copied config.yml is ignored by Git.

local:
  product_root: C:/datasets/products
  artifacts_root: .artifacts

environment:
  S3_MAIN_BUCKET_NAME: ""
  S3_MAIN_ENDPOINT: ""
  S3_MAIN_REGION: auto
  S3_MAIN_ACCESS_KEY: ""
  S3_MAIN_SECRET_KEY: ""

binaries:
  hostapp_cli_linux_x64:
    version: ""
    url: ""
    sha256: ""

dataset:
  blender_versions:
    - 5.2.0
    - 5.2.1
  blender_platforms:
    - linux-x64

remote:
  default_target: sv1
  workspace_root: /tmp/hostapp-gutch-benchmark
  fixtures_root: /home/user/hostapp/benchmark-fixtures/gutch
  python: python3

ssh:
  sv1:
    host: ""
    port: 22
    user: ""
    host_alias: ""
    identity_file: ""

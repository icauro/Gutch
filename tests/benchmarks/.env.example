# Copy this file to gutch_repo/tests/benchmarks/.env for local benchmark runs.
# The real .env file is ignored and must never be committed.

# Production or remote S3 targets used by S3_MAIN-prefixed fixture targets.
S3_MAIN_BUCKET_NAME=
S3_MAIN_ENDPOINT=
S3_MAIN_REGION=auto
S3_MAIN_ACCESS_KEY=
S3_MAIN_SECRET_KEY=

# Optional local SeaweedFS overrides for the reconstruction-storage fixture.
# If omitted, that fixture uses its own local development defaults.
# HOSTAPP_SEAWEED_ENDPOINT=http://127.0.0.1:9744
# HOSTAPP_SEAWEED_BUCKET=hostapp-main
# HOSTAPP_SEAWEED_REGION=auto
# HOSTAPP_SEAWEED_ACCESS_KEY=hostapp-local
# HOSTAPP_SEAWEED_SECRET_KEY=hostapp-local-secret-key

# Copy this file to config.yml and fill in the benchmark paths, credentials,
# and optional external storage values. The copied config.yml is ignored by Git.

local:
  product_root: C:/datasets/products
  artifacts_root: .artifacts

environment:
  S3_MAIN_BUCKET_NAME: ""
  S3_MAIN_ENDPOINT: ""
  S3_MAIN_REGION: auto
  S3_MAIN_ACCESS_KEY: ""
  S3_MAIN_SECRET_KEY: ""

dataset:
  blender_versions:
    - 5.2.0
    - 5.2.1
  blender_platforms:
    - linux-x64
